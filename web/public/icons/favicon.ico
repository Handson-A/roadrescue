<?xml version="1.0" encoding="UTF-8"?>
<!-- Favicon for RoadRescue - For browser tabs and bookmarks -->
<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
  <rect width="64" height="64" fill="#FF4444"/>
  <g transform="translate(16, 16)">
    <!-- Simplified vehicle icon -->
    <rect x="0" y="6" width="16" height="8" fill="white" rx="1"/>
    <rect x="12" y="3" width="4" height="7" fill="white" rx="1"/>
    <circle cx="4" cy="18" r="2" fill="white"/>
    <circle cx="12" cy="18" r="2" fill="white"/>
    <!-- Cross -->
    <rect x="6" y="2" width="4" height="14" fill="white"/>
    <rect x="4" y="8" width="8" height="2" fill="white"/>
  </g>
</svg>
