# ============================================================================
# RoadRescue Environment Variables — Production Ready
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in YOUR values from your Supabase & Google Cloud dashboards
# 3. NEVER commit .env.local or .env to git (kept in .gitignore)
# 4. Add production secrets to Vercel dashboard (Settings → Environment Variables)

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# MAP PROVIDER CONFIG
# ============================================================================
# This project uses Leaflet + OpenStreetMap tiles for maps and reverse geocoding
# (Nominatim). No Google Maps API key is required. If you choose to switch to a
# paid geocoding provider later, add its key here.

# ============================================================================
# AI DIAGNOSTICS MULTI-PROVIDER CONFIGURATION
# ============================================================================
# Primary Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback Provider 1: Groq (Ultra-fast Llama-3 inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Provider 2: OpenRouter (Flexible multi-model gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Provider timeout in milliseconds before triggering automatic fallback (default: 7000ms)
AI_PROVIDER_TIMEOUT_MS=7000

# ============================================================================
# RESEND EMAIL SERVICE (Required for notifications)
# ============================================================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=RoadRescue <onboarding@resend.dev>
# Replace with your verified production sender.

# ============================================================================
# APPLICATION CONFIG (Required)
# ============================================================================
NEXT_PUBLIC_APP_URL=
