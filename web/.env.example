# ============================================================================
# RoadRescue Environment Variables — Production Ready
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in YOUR values from your Supabase & Google Cloud dashboards
# 3. NEVER commit .env.local or .env to git (kept in .gitignore)
# 4. Add production secrets to Vercel dashboard (Settings → Environment Variables)

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# GOOGLE MAPS API (Required for map features)
# ============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyD...

# ============================================================================
# OPENAI API (Required for AI Diagnostics)
# ============================================================================
OPENAI_API_KEY=sk-proj-...

# ============================================================================
# RESEND EMAIL SERVICE (Required for notifications)
# ============================================================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=RoadRescue <onboarding@resend.dev>
# Replace with your verified production sender once your domain is approved in Resend.

# ============================================================================
# APPLICATION CONFIG (Required)
# ============================================================================
NEXT_PUBLIC_APP_URL=

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=true
NEXT_PUBLIC_ENABLE_AI_DIAGNOSTICS=true
NEXT_PUBLIC_ENABLE_MECHANIC_NAVIGATION=true
